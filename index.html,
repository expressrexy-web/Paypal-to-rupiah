<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080f1e">
<meta name="description" content="Kalkulator konversi saldo PayPal USD ke Rupiah Indonesia dengan kurs terbaru.">
<title>PayPal to Rupiah — USD to IDR</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #080f1e;
  --card: #111c30;
  --border: #25344b;
  --text: #f1f5f9;
  --muted: #8fa2bc;
  --green: #45e0a0;
  --blue: #6d91ff;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(ellipse at 50% 0%, #172d52 0%, transparent 60%),
    var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding: 24px;
}

.container {
  max-width: 500px;
  margin: 45px auto;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 32px;
}

.logo-icon {
  background: #1465dc;
  width: 43px;
  height: 43px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-size: 23px;
  font-weight: 800;
  font-style: italic;
}

.logo h1 {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.7px;
}

.logo h1 span {
  color: var(--green);
}

.subtitle {
  text-align: center;
  color: var(--muted);
  font-size: 13px;
  margin-top: 6px;
  font-weight: 400;
}

.card {
  background: linear-gradient(145deg, #142138, #0e1829);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 27px;
  box-shadow: 0 25px 70px #0004;
}

.label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 12px;
  display: block;
}

.input-box {
  background: #0a1323;
  border: 1px solid #2a3b55;
  border-radius: 15px;
  display: flex;
  align-items: center;
  padding: 16px;
  gap: 12px;
  transition: border .2s;
}

.input-box:focus-within {
  border-color: var(--blue);
}

.currency-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 18px;
  font-weight: 800;
  flex-shrink: 0;
}

.usd {
  background: #18396a;
  color: #8cb7ff;
}

.idr {
  background: #552a35;
  color: #ff8d9c;
}

.currency-info {
  min-width: 0;
}

.currency-info strong {
  font-size: 14px;
  display: block;
  margin-bottom: 5px;
}

.currency-info small {
  font-size: 11px;
  color: var(--muted);
}

.input-box input {
  width: 100%;
  min-width: 0;
  text-align: right;
  border: 0;
  outline: 0;
  color: white;
  background: transparent;
  font-family: inherit;
  font-size: 21px;
  font-weight: 700;
}

.swap-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16px 0;
}

.rate {
  color: var(--muted);
  font-size: 11px;
}

.swap {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: #243654;
  color: var(--green);
  border: 1px solid #34496b;
  font-size: 20px;
  cursor: pointer;
  transition: .2s;
}

.swap:hover {
  background: #30486d;
  transform: rotate(180deg);
}

.result-box {
  background: linear-gradient(135deg, #123d36, #102b30);
  border: 1px solid #286452;
  border-radius: 18px;
  padding: 22px;
  margin-top: 23px;
}

.result-label {
  color: #a2dcca;
  font-size: 12px;
  margin-bottom: 10px;
}

.result {
  color: var(--green);
  font-size: clamp(27px, 7vw, 36px);
  font-weight: 800;
  letter-spacing: -1.5px;
  overflow-wrap: anywhere;
}

.result-sub {
  color: #a2dcca;
  font-size: 11px;
  margin-top: 10px;
}

.copy-btn {
  width: 100%;
  margin-top: 15px;
  padding: 14px;
  border-radius: 12px;
  background: var(--green);
  border: 0;
  color: #09251b;
  font-family: inherit;
  font-weight: 800;
  font-size: 13px;
  cursor: pointer;
  transition: .2s;
}

.copy-btn:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

.settings {
  margin-top: 23px;
  border-top: 1px solid var(--border);
  padding-top: 20px;
}

.settings-title {
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 15px;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 16px;
}

.setting-row label {
  font-size: 12px;
  color: #bdc9da;
}

.setting-row input {
  width: 100px;
  background: #091323;
  border: 1px solid #30415b;
  padding: 10px;
  border-radius: 9px;
  color: white;
  outline: none;
  font-family: inherit;
  text-align: right;
}

.setting-row input:focus {
  border-color: var(--blue);
}

.note {
  font-size: 10px;
  color: var(--muted);
  line-height: 1.7;
  margin-top: 20px;
}

.status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-size: 11px;
  color: var(--muted);
  margin-top: 17px;
  text-align: center;
}

.dot {
  height: 7px;
  width: 7px;
  border-radius: 50%;
  background: var(--green);
  flex-shrink: 0;
}

footer {
  text-align: center;
  margin-top: 25px;
  color: #63758f;
  font-size: 10px;
  line-height: 1.8;
}

@media (max-width: 480px) {
  body { padding: 16px; }
  .container { margin: 25px auto; }
  .card { padding: 20px; }
  .input-box { padding: 12px; gap: 9px; }
  .currency-icon { width: 36px; height: 36px; }
  .input-box input { font-size: 18px; }
}
</style>
</head>

<body>
<main class="container">

  <header class="logo">
    <div class="logo-icon">P</div>
    <div>
      <h1>PayPal <span>to Rupiah</span></h1>
      <p class="subtitle">Simple USD to IDR Converter</p>
    </div>
  </header>

  <section class="card">

    <label class="label" for="amount">JUMLAH SALDO PAYPAL</label>

    <div class="input-box">
      <div class="currency-icon usd">$</div>
      <div class="currency-info">
        <strong>USD</strong>
        <small>US Dollar</small>
      </div>
      <input id="amount" type="number" min="0" step="any"
        value="100" placeholder="0.00" inputmode="decimal">
    </div>

    <div class="swap-row">
      <span class="rate" id="rateText">Mengambil kurs terbaru...</span>
      <button class="swap" id="swapBtn" title="Tukar arah konversi"
        aria-label="Tukar arah konversi">⇅</button>
    </div>

    <label class="label" id="outputLabel" for="output">ESTIMASI DALAM RUPIAH</label>

    <div class="input-box">
      <div class="currency-icon idr">Rp</div>
      <div class="currency-info">
        <strong id="outputCode">IDR</strong>
        <small id="outputName">Indonesian Rupiah</small>
      </div>
      <input id="output" type="text" value="—" readonly>
    </div>

    <div class="result-box">
      <div class="result-label">Estimasi saldo diterima</div>
      <div class="result" id="result">Rp 0</div>
      <div class="result-sub" id="resultSub">
        Sebelum potongan biaya
      </div>
      <button class="copy-btn" id="copyBtn">Salin Hasil Konversi</button>
    </div>

    <div class="settings">
      <div class="settings-title">⚙️ Pengaturan Konversi</div>

      <div class="setting-row">
        <label for="fee">Simulasi biaya (%)</label>
        <input id="fee" type="number" min="0" max="100"
          step="0.1" value="0" inputmode="decimal">
      </div>

      <div class="setting-row">
        <label for="adjustment">Penyesuaian kurs (%)</label>
        <input id="adjustment" type="number" min="-100"
          max="100" step="0.1" value="0" inputmode="decimal">
      </div>
    </div>

    <p class="note">
      * Kurs diambil dari layanan nilai tukar mata uang dan bukan
      kurs transaksi resmi PayPal. Kurs PayPal dapat berbeda.
      Biaya transaksi, penarikan, dan konversi aktual bergantung
      pada jenis transaksi serta ketentuan akunmu. Pengaturan biaya
      di atas hanya simulasi.
    </p>

    <div class="status">
      <span class="dot" id="statusDot"></span>
      <span id="status">Menghubungkan ke layanan kurs...</span>
    </div>

  </section>

  <footer>
    PayPal to Rupiah Converter © 2026<br>
    Informasi konversi bersifat estimasi, bukan nilai transaksi final.
  </footer>

</main>

<script>
const $ = id => document.getElementById(id);

let usdToIdr = 0;
let direction = 'USD-IDR';

const money = (value, currency) =>
  new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency,
    minimumFractionDigits: 0,
    maximumFractionDigits: currency === 'USD' ? 2 : 0
  }).format(value);

function getValues() {
  const amount = Math.max(0, Number($('amount').value) || 0);
  const fee = Math.min(100, Math.max(0, Number($('fee').value) || 0));
  const adjustment = Math.min(100, Math.max(-100,
    Number($('adjustment').value) || 0));

  return { amount, fee, adjustment };
}

function calculate() {
  if (!usdToIdr) return;

  const { amount, fee, adjustment } = getValues();
  const effectiveRate = usdToIdr * (1 + adjustment / 100);

  const isUsdToIdr = direction === 'USD-IDR';
  const sourceCode = isUsdToIdr ? 'USD' : 'IDR';
  const targetCode = isUsdToIdr ? 'IDR' : 'USD';

  const converted = isUsdToIdr
    ? amount * effectiveRate
    : amount / effectiveRate;

  // Simulasi biaya diterapkan pada hasil konversi.
  const received = converted * (1 - fee / 100);

  $('output').value = money(converted, targetCode);
  $('result').textContent = money(received, targetCode);
  $('resultSub').textContent =
    fee > 0
      ? `Setelah simulasi potongan ${fee}%`
      : 'Belum termasuk biaya transaksi PayPal';

  $('rateText').textContent =
    `1 USD ≈ ${money(usdToIdr, 'IDR')}`;
}

async function loadRate() {
  $('status').textContent = 'Memperbarui kurs...';
  $('statusDot').style.background = '#f5c66b';

  try {
    const response = await fetch(
      'https://open.er-api.com/v6/latest/USD',
      { cache: 'no-store' }
    );

    if (!response.ok) throw new Error('Gagal mengambil kurs');

    const data = await response.json();

    if (data.result !== 'success' ||
        !Number.isFinite(data.rates?.IDR)) {
      throw new Error('Data kurs tidak valid');
    }

    usdToIdr = data.rates.IDR;
    const updated = data.time_last_update_utc || 'Terbaru tersedia';

    $('status').textContent = `Kurs referensi berhasil dimuat · ${updated}`;
    $('statusDot').style.background = '#45e0a0';

    calculate();
  } catch (error) {
    $('status').textContent =
      usdToIdr
        ? 'Gagal memperbarui. Menggunakan kurs terakhir.'
        : 'Kurs gagal dimuat. Periksa koneksi internet.';
    $('statusDot').style.background = '#ff7777';

    if (!usdToIdr) {
      $('result').textContent = 'Kurs tidak tersedia';
      $('output').value = '—';
      $('rateText').textContent = 'Tidak dapat mengambil kurs';
    }
  }
}

$('amount').addEventListener('input', calculate);
$('fee').addEventListener('input', calculate);
$('adjustment').addEventListener('input', calculate);

$('swapBtn').addEventListener('click', () => {
  direction = direction === 'USD-IDR' ? 'IDR-USD' : 'USD-IDR';

  const isUsdToIdr = direction === 'USD-IDR';

  $('amount').value = '';
  $('amount').placeholder = '0.00';
  $('outputLabel').textContent =
    isUsdToIdr ? 'ESTIMASI DALAM RUPIAH' : 'ESTIMASI DALAM DOLAR';
  $('outputCode').textContent = isUsdToIdr ? 'IDR' : 'USD';
  $('outputName').textContent =
    isUsdToIdr ? 'Indonesian Rupiah' : 'US Dollar';
  $('resultSub').textContent = 'Hasil konversi estimasi';

  calculate();
});

$('copyBtn').addEventListener('click', async () => {
  const text =
    `${$('amount').value} ${direction.split('-')[0]} = ` +
    `${$('result').textContent}`;

  try {
    await navigator.clipboard.writeText(text);
    $('copyBtn').textContent = '✓ Berhasil Disalin!';
  } catch {
    $('copyBtn').textContent = 'Salin gagal. Coba gunakan HTTPS.';
  }

  setTimeout(() => {
    $('copyBtn').textContent = 'Salin Hasil Konversi';
  }, 1800);
});

loadRate();

// Perbarui kurs setiap 30 menit.
setInterval(loadRate, 30 * 60 * 1000);
</script>

</body>
</html>
